        "subject": "=[SMARTFLOW-BK1] New Booking \u2014 {{ $node[\"Validate + Book\"].json.booking.name }} \u00b7 {{ $node[\"Validate + Book\"].json.booking.date }} {{ $node[\"Validate + Book\"].json.booking.time }}",
        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html>\n<body style=\"font-family:Arial,sans-serif;color:#1E293B;max-width:600px;margin:0 auto;padding:24px;\">\n  <div style=\"background:linear-gradient(135deg,#1e3a8a,#2563EB);border-radius:12px;padding:24px;margin-bottom:24px;\">\n    <h1 style=\"color:white;margin:0;font-size:20px;\">&#128205; New SmartFlow Booking</h1>\n    <p style=\"color:rgba(255,255,255,0.8);margin:8px 0 0;font-size:13px;\">SMARTFLOW-BK1 Notification</p>\n  </div>\n  <table style=\"width:100%;border-collapse:collapse;font-size:14px;\">\n    <tr style=\"background:#F8FAFC;\">\n      <td style=\"padding:12px 16px;font-weight:700;width:36%;border-bottom:1px solid #E2E8F0;\">Name</td>\n      <td style=\"padding:12px 16px;border-bottom:1px solid #E2E8F0;\">{{ $node[\"Validate + Book\"].json.booking.name }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding:12px 16px;font-weight:700;border-bottom:1px solid #E2E8F0;\">Email</td>\n      <td style=\"padding:12px 16px;border-bottom:1px solid #E2E8F0;\">{{ $node[\"Validate + Book\"].json.booking.email }}</td>\n    </tr>\n    <tr style=\"background:#F8FAFC;\">\n      <td style=\"padding:12px 16px;font-weight:700;border-bottom:1px solid #E2E8F0;\">Phone</td>\n      <td style=\"padding:12px 16px;border-bottom:1px solid #E2E8F0;\">{{ $node[\"Validate + Book\"].json.booking.phone }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding:12px 16px;font-weight:700;border-bottom:1px solid #E2E8F0;\">Agency</td>\n      <td style=\"padding:12px 16px;border-bottom:1px solid #E2E8F0;\">{{ $node[\"Validate + Book\"].json.booking.agency }}</td>\n    </tr>\n    <tr style=\"background:#F8FAFC;\">\n      <td style=\"padding:12px 16px;font-weight:700;border-bottom:1px solid #E2E8F0;\">Date</td>\n      <td style=\"padding:12px 16px;border-bottom:1px solid #E2E8F0;\">{{ $node[\"Validate + Book\"].json.booking.date }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding:12px 16px;font-weight:700;border-bottom:1px solid #E2E8F0;\">Time</td>\n      <td style=\"padding:12px 16px;border-bottom:1px solid #E2E8F0;\">{{ $node[\"Validate + Book\"].json.booking.time }} AWST</td>\n    </tr>\n    <tr style=\"background:#F8FAFC;\">\n      <td style=\"padding:12px 16px;font-weight:700;border-bottom:1px solid #E2E8F0;\">Slot ID</td>\n      <td style=\"padding:12px 16px;border-bottom:1px solid #E2E8F0;font-family:monospace;\">{{ $node[\"Validate + Book\"].json.booking.slot_id }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding:12px 16px;font-weight:700;border-bottom:1px solid #E2E8F0;\">Message</td>\n      <td style=\"padding:12px 16px;border-bottom:1px solid #E2E8F0;\">{{ $node[\"Validate + Book\"].json.booking.message || \"(none)\" }}</td>\n    </tr>\n    <tr style=\"background:#F8FAFC;\">\n      <td style=\"padding:12px 16px;font-weight:700;\">Booked At</td>\n      <td style=\"padding:12px 16px;\">{{ $node[\"Validate + Book\"].json.booking.booked_at }}</td>\n    </tr>\n  </table>\n</body>\n</html>",
